# Configuration for deploy/docker-compose.yml. Copy to deploy/.env (git-ignored).

# --- 9router container ---------------------------------------------------------
# Dashboard password. Choose a long random value (for example: openssl rand -hex 24).
ROUTER_DASHBOARD_PASSWORD=
# Pin image versions for reproducible deployments.
ROUTER_IMAGE_TAG=latest
HERMES_IMAGE_TAG=latest

# --- Job Radar -----------------------------------------------------------------
# Create the API key in the 9router dashboard after the first start, then fill it in.
ROUTER_API_KEY=
SCORING_MODEL=job-scorer
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Absolute path on the host to your profile.yaml (defaults to the bundled example).
# RADAR_PROFILE_PATH=/opt/job-radar/profile.yaml
