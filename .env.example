# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Telegram delivery (create a bot with @BotFather; the chat id is your numeric user id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OpenAI-compatible endpoint used for scoring (9router by default)
ROUTER_BASE_URL=http://localhost:20128/v1
ROUTER_API_KEY=
SCORING_MODEL=job-scorer

# Optional path overrides (the Docker image sets these)
# RADAR_DB_PATH=./data/jobs.db
# RADAR_PROFILE=./profile.yaml
